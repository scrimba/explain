{
  "description": "Offers a Scrimba explainer when the agent has changed a lot of code in a session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/scrimba-offer.mjs\" claude-code || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/scrimba-offer.mjs\" claude-code || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
